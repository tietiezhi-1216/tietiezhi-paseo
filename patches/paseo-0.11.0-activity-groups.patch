diff --git a/packages/app/src/plugins/timeline/activity-groups.ts b/packages/app/src/plugins/timeline/activity-groups.ts
new file mode 100644
index 0000000..1ec18ac
--- /dev/null
+++ b/packages/app/src/plugins/timeline/activity-groups.ts
@@ -0,0 +1,117 @@
+import type { PluginTimelineStreamItem, StreamItem } from "@/types/stream";
+import { continuesTurn } from "@/agent-stream/turn-membership";
+
+// Local prototype adapter for tietiezhi's registered compact-activity-group renderer.
+// Other installations and native plan/subagent/worktree rows remain untouched.
+function isActivity(item: StreamItem): item is PluginTimelineStreamItem {
+  return (
+    item.kind === "plugin" &&
+    item.pluginId === "tietiezhi" &&
+    item.version === 1 &&
+    (item.itemKind === "compact-tool" || item.itemKind === "compact-reasoning")
+  );
+}
+function canJoin(
+  previous: PluginTimelineStreamItem,
+  next: StreamItem,
+): next is PluginTimelineStreamItem {
+  return isActivity(next) && continuesTurn(previous, next);
+}
+interface PreparedActivities {
+  rows: StreamItem[];
+  pending: PluginTimelineStreamItem[];
+}
+function retain(previous: StreamItem[], next: StreamItem[]): StreamItem[] {
+  const unchanged =
+    previous.length === next.length && previous.every((item, index) => item === next[index]);
+  return unchanged ? previous : next;
+}
+
+export function createPluginActivityGrouping() {
+  const prepared = new WeakMap<StreamItem[], PreparedActivities>();
+  const groups = new WeakMap<
+    PluginTimelineStreamItem,
+    { members: PluginTimelineStreamItem[]; row: PluginTimelineStreamItem }
+  >();
+  let previousTail: StreamItem[] = [];
+  let previousHead: StreamItem[] = [];
+  function buildGroup(members: PluginTimelineStreamItem[]): PluginTimelineStreamItem {
+    const first = members[0];
+    const latest = members.at(-1);
+    if (!first || !latest) throw new Error("Empty activity group");
+    const cached = groups.get(first);
+    const unchanged =
+      cached &&
+      cached.members.length === members.length &&
+      cached.members.every((item, index) => item === members[index]);
+    if (unchanged) return cached.row;
+    const row: PluginTimelineStreamItem = {
+      ...latest,
+      id: first.id,
+      pluginItemId: first.pluginItemId,
+      itemKind: "compact-activity-group",
+      data: {
+        items: members.map((item) => ({
+          id: item.id,
+          kind: item.itemKind,
+          version: item.version,
+          timestamp: item.timestamp.toISOString(),
+          data: item.data,
+        })),
+      },
+    };
+    groups.set(first, { members, row });
+    return row;
+  }
+  function prepare(tail: StreamItem[]): PreparedActivities {
+    const cached = prepared.get(tail);
+    if (cached) return cached;
+    const rows: StreamItem[] = [];
+    let pending: PluginTimelineStreamItem[] = [];
+    function flush() {
+      if (pending.length) rows.push(buildGroup(pending));
+      pending = [];
+    }
+    for (const item of tail) {
+      const latest = pending.at(-1);
+      if (latest && !canJoin(latest, item)) flush();
+      if (isActivity(item)) pending.push(item);
+      else rows.push(item);
+    }
+    const trailing = pending;
+    flush();
+    const result = { rows: retain(tail, rows), pending: trailing };
+    prepared.set(tail, result);
+    return result;
+  }
+  return (input: { tail: StreamItem[]; head: StreamItem[] }) => {
+    const history = prepare(input.tail);
+    let pending = [...history.pending];
+    let inHistory = pending.length > 0;
+    let changedHistory = false;
+    let tail = history.rows;
+    const head: StreamItem[] = [];
+    function flush() {
+      if (pending.length) {
+        const row = buildGroup(pending);
+        if (inHistory && changedHistory) tail = [...history.rows.slice(0, -1), row];
+        if (!inHistory) head.push(row);
+      }
+      pending = [];
+      inHistory = false;
+      changedHistory = false;
+    }
+    for (const item of input.head) {
+      const latest = pending.at(-1);
+      if (latest && !canJoin(latest, item)) flush();
+      if (isActivity(item)) {
+        pending.push(item);
+        if (inHistory) changedHistory = true;
+      } else head.push(item);
+    }
+    flush();
+    previousTail = retain(previousTail, retain(input.tail, tail));
+    previousHead = retain(previousHead, retain(input.head, head));
+    return { tail: previousTail, head: previousHead };
+  };
+}
